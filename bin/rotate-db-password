#!/bin/bash
# 轮换 Supabase 数据库密码后，同步本地 .env 和 Railway 变量。
#
# 用法：先在 Supabase dashboard 重置密码，然后在**自己的终端**里跑：
#   bin/rotate-db-password
# 密码只从键盘读（不回显），不打印、不进 shell 历史、不出现在进程参数里。
# 按「单向流动」原则：签发方 → 本机 → 部署平台，不经过对话。

set -euo pipefail
REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO"

read -rsp "粘贴新的数据库密码（输入不回显），回车: " PW; echo
[ -n "$PW" ] || { echo "密码为空，什么都没改。"; exit 1; }
export PW

# 用 .env 里现有连接串的用户名/主机/端口/库名，只换密码
NEW_URL="$(python3 - <<'PY'
import os, urllib.parse
from pathlib import Path
line = next(l for l in Path(".env").read_text().splitlines()
            if l.startswith("GTM_BRAIN_DATABASE_URL="))
u = urllib.parse.urlsplit(line.split("=", 1)[1].strip().strip('"'))
pw = urllib.parse.quote(os.environ["PW"], safe="")
print(urllib.parse.urlunsplit(u._replace(netloc=f"{u.username}:{pw}@{u.hostname}:{u.port}")))
PY
)"
export NEW_URL
unset PW

echo "1/3 验证新密码能连上数据库…"
# Supabase 的连接池更新密码要十几秒，失败就重试几次
ok=0
for i in 1 2 3 4 5 6; do
  if uv run -q --with 'psycopg[binary]' python -c \
      "import os,psycopg; psycopg.connect(os.environ['NEW_URL'],connect_timeout=15).execute('select 1')" \
      >/dev/null 2>&1; then ok=1; break; fi
  echo "    还连不上，${i}/6，10 秒后重试…"; sleep 10
done
[ "$ok" = 1 ] || { echo "✗ 新密码连不上数据库。检查是否粘贴完整。本地和 Railway 都没改。"; exit 1; }
echo "    ✓ 连接成功"

echo "2/3 更新本地 .env…"
python3 - <<'PY'
import os
from pathlib import Path
p = Path(".env")
lines = p.read_text().splitlines()
lines = [f"GTM_BRAIN_DATABASE_URL={os.environ['NEW_URL']}"
         if l.startswith("GTM_BRAIN_DATABASE_URL=") else l for l in lines]
p.write_text("\n".join(lines) + "\n")
PY
echo "    ✓ 已更新"

echo "3/3 更新 Railway 变量（会自动触发一次重新部署）…"
printf '%s' "$NEW_URL" | railway variable set GTM_BRAIN_DATABASE_URL --stdin -s gtm-brain >/dev/null
unset NEW_URL
echo "    ✓ 已提交，等待服务重启…"

sleep 30
for i in $(seq 1 30); do
  if curl -s -m 15 https://gtm-brain-production.up.railway.app/health | grep -q '"ok"'; then
    echo ""
    echo "✓ 完成。服务已用新密码重新上线。告诉 Claude「密码换好了」，它会做一次端到端验证。"
    exit 0
  fi
  sleep 10
done
echo "⚠ 服务 5 分钟内没恢复健康。本地 .env 已更新；把这句话告诉 Claude，让它看 Railway 日志。"
exit 1

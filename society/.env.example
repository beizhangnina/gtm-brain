# society 实验用凭证模板
# 用法：cp society/.env.example society/.env 然后填值。society/.env 已被 gitignore。
# 真正的 key 只放本地，不要贴进任何对话或提交。

# --- Flatkey（LLM 路由 + Tool Marketplace）--------------------
# 一个 key 覆盖 100+ 模型和 1000+ 按次计费工具
# （X / Reddit / LinkedIn / TikTok / YouTube / Apify / Browserbase / Exa / Apollo / PDL …）
# 取 key：https://console.flatkey.ai  → 工具清单：https://console.flatkey.ai/api-marketplace
FLATKEY_API_KEY=

# --- Deepline（GTM 数据）--------------------------------------
# crustdata（便宜的索引式人/公司搜索）、peopledatalabs、bloomberry（技术栈变动）、
# hackernews、twitterapi 等
# 本机 deepline CLI 已登录的话，这一行可留空，脚本会走 CLI
DEEPLINE_API_KEY=

# --- 模拟用的模型（走 Flatkey，挑便宜档）----------------------
SOCIETY_LLM_BASE_URL=https://router.flatkey.ai/v1
SOCIETY_LLM_MODEL=deepseek-v4-flash

# --- 成本闸门（防止手滑烧钱）--------------------------------
# 单次实验的预算上限（美元）。脚本超过就停。
SOCIETY_BUDGET_USD=20

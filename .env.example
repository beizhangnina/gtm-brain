# ============================================================
# gtm-brain 环境变量模板
# 用法：cp .env.example .env 然后填值。.env 已被 .gitignore 忽略。
# 生产环境的值请走 1Password → Railway dashboard，不要只存这里。
# ============================================================

# --- Obsidian vault ---------------------------------------
# GTM 内容的根目录（对账器只读这里，永不写入）
GTM_VAULT_PATH=/Users/beizhang/Documents/Bei_Brain/01-Projects/Dormy/GTM

# --- Embedding（Voyage，文本+图片+重排 一个 key 全包）--------
# https://dash.voyageai.com/api-keys
VOYAGE_API_KEY=

# --- 图片托管（Supabase Storage）----------------------------
# Supabase 项目设置 → API
SUPABASE_URL=
# service_role key（上传用，权限高，勿外泄）
SUPABASE_SERVICE_KEY=
# 存图片衍生品的 bucket 名
SUPABASE_BUCKET=gtm-assets

# --- gbrain 服务端（Phase 2 建完 Railway 后填）---------------
# Railway Postgres 内网连接串
GTM_BRAIN_DATABASE_URL=
# 部署后的 MCP 公网地址，例：https://gtm-brain-production.up.railway.app
GTM_BRAIN_URL=
# ingest 专用 OAuth client（gbrain auth register-client 生成，需 write scope）
GTM_BRAIN_CLIENT_ID=
GTM_BRAIN_CLIENT_SECRET=

# --- LLM（think 综合 + query 扩展）：flatkey 上的 deepseek-v4-flash ---
# https://flatkey.ai 新建一个 gtm-brain 专用 key
DEEPSEEK_API_KEY=
